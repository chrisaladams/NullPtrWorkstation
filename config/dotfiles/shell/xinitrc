#!/bin/sh
# nullptr Workstation — started by startx from ~/.bash_profile on tty1.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
  # shellcheck disable=SC1090
  for f in /etc/X11/xinit/xinitrc.d/?*.sh; do [ -x "$f" ] && . "$f"; done
fi
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
# let systemd user services (PipeWire, etc.) see the display
systemctl --user import-environment DISPLAY XAUTHORITY 2>/dev/null
command -v dbus-update-activation-environment >/dev/null && dbus-update-activation-environment --systemd DISPLAY XAUTHORITY
exec i3
