# nullptr Workstation — i3status (top bar)
general {
  colors = true
  color_good = "#9ece6a"
  color_degraded = "#e0af68"
  color_bad = "#f7768e"
  interval = 5
}
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "volume master"
order += "cpu_usage"
order += "memory"
order += "tztime local"

wireless _first_ { format_up = "󰖩 %essid %quality" format_down = "󰖪 no wifi (nmtui)" }
ethernet _first_ { format_up = "󰈀 %ip" format_down = "" }
battery all {
  format = "%status %percentage %remaining"
  format_down = ""
  status_chr = "󰂄" status_bat = "󰁹" status_unk = "󰂑" status_full = "󰁹"
  low_threshold = 15 threshold_type = percentage
  integer_battery_capacity = true
}
volume master { format = "󰕾 %volume" format_muted = "󰖁 muted" device = "default" }
cpu_usage { format = "󰻠 %usage" }
memory { format = "󰍛 %used" threshold_degraded = "1G" }
tztime local { format = "󰥔 %a %d %b %H:%M" }
