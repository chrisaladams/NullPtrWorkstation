# nullptr Workstation — i3 configuration
# Super (the Windows key) is the modifier. Press Super+F1 for the cheat sheet.
set $mod Mod4
font pango:JetBrainsMono Nerd Font 10

# Tokyo Night palette
set $bg     #1a1b26
set $bg2    #24283b
set $fg     #c0caf5
set $blue   #7aa2f7
set $lav    #bb9af7
set $green  #9ece6a
set $warm   #e0af68
set $red    #f7768e
set $muted  #565f89

#                       border  background text  indicator child_border
client.focused          $blue   $blue      $bg   $lav      $blue
client.focused_inactive $bg2    $bg2       $fg   $bg2      $bg2
client.unfocused        $bg     $bg        $muted $bg      $bg
client.urgent           $red    $red       $bg   $red      $red

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
focus_follows_mouse no
workspace_auto_back_and_forth no

# ---------------------------------------------------------------- workspaces
# keep in sync with scripts/lib/nullptr-common.sh and nvim lua/nullptr/project.lua
set $ws1 "1: astro"
set $ws2 "2: libresprite"
set $ws3 "3: tiled"
set $ws4 "4: blender"
set $ws5 "5: game"
set $ws6 "6: tools"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6

# Applications always land on their workspace (switching workspaces never starts anything)
assign [class="(?i)^libresprite$"] number $ws2
assign [class="(?i)^tiled$"] number $ws3
assign [class="^Blender$"] number $ws4
assign [class="(?i)emulicious"] number $ws5
assign [title="(?i)^emulicious"] number $ws5
assign [class="(?i)^vscodium$"] number $ws6
for_window [class="^nullptr-dev$"] move container to workspace number $ws1, fullscreen enable
for_window [class="^nullptr-help$"] floating enable, resize set 1000 700, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

# ---------------------------------------------------------------- essentials
bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+Shift+Return exec --no-startup-id dev-terminal
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill
bindsym $mod+l exec --no-startup-id nullptr-lock
bindsym $mod+a exec --no-startup-id art
bindsym $mod+t exec --no-startup-id tiles
bindsym $mod+b exec --no-startup-id 3d
bindsym $mod+d exec --no-startup-id dmenu_run -fn 'JetBrainsMono Nerd Font-11' -nb '#1a1b26' -nf '#c0caf5' -sb '#7aa2f7' -sf '#1a1b26'
bindsym $mod+F1 exec --no-startup-id kitty --class nullptr-help -e keys

# focus / move with arrows
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# layout
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+e layout toggle split
bindsym $mod+w layout tabbed
bindsym $mod+Shift+space floating toggle
floating_modifier $mod

# session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Leave the graphical session? (tmux keeps running)' -B 'Yes, exit i3' 'i3-msg exit'

# resize mode (Super+R, then arrows, Esc to leave)
mode "resize" {
  bindsym Left  resize shrink width 5 px or 5 ppt
  bindsym Right resize grow width 5 px or 5 ppt
  bindsym Up    resize grow height 5 px or 5 ppt
  bindsym Down  resize shrink height 5 px or 5 ppt
  bindsym Escape mode "default"
  bindsym Return mode "default"
}
bindsym $mod+r mode "resize"

# ---------------------------------------------------------------- laptop keys
bindsym XF86AudioRaiseVolume  exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume  exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute         exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute      exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl -q set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -q set 5%-

# ---------------------------------------------------------------- bar
bar {
  status_command i3status
  position top
  tray_output none
  font pango:JetBrainsMono Nerd Font 10
  colors {
    background $bg
    statusline $fg
    separator  $muted
    focused_workspace  $blue $blue $bg
    active_workspace   $bg2  $bg2  $fg
    inactive_workspace $bg   $bg   $muted
    urgent_workspace   $red  $red  $bg
  }
}

# ---------------------------------------------------------------- startup (runs once per login, not on reload)
exec --no-startup-id xss-lock --transfer-sleep-lock -- nullptr-lock
exec --no-startup-id xsetroot -solid '#1a1b26'
exec --no-startup-id tablet-setup --apply
exec --no-startup-id dev-terminal
