#!/usr/bin/env bash
set -euo pipefail
_d="$(dirname -- "$(readlink -f -- "$0")")"
for _l in "$_d/../lib/nullptr" "$_d/../lib"; do [ -f "$_l/nullptr-common.sh" ] && break; done
# shellcheck source=../lib/nullptr-common.sh
. "$_l/nullptr-common.sh"
# shellcheck source=../lib/nullptr-actions.sh
. "$_l/nullptr-actions.sh"
# art [FILE] — focus LibreSprite on workspace 2, or start it (never starts a duplicate)
case "${1:-}" in -h|--help) echo "Usage: art [FILE.png|.ase]   Open LibreSprite (workspace 2: libresprite). Default folder: active project's assets/"; exit 0 ;; esac
nw_in_graphical || nw_die "LibreSprite needs the graphical session."
bin="$(command -v libresprite || true)"
[ -n "$bin" ] || nw_die "LibreSprite is not installed."
if [ $# -eq 0 ] && pgrep -u "$(id -u)" -x libresprite >/dev/null 2>&1; then
  nw_i3 -q '[class="(?i)libresprite"] focus' 2>/dev/null || nw_i3_workspace libresprite
  exit 0
fi
dir="$HOME"
if p="$(nw_active_get 2>/dev/null)"; then mkdir -p "$p/assets"; dir="$p/assets"; fi
nw_i3_workspace libresprite
cd "$dir"
if [ $# -gt 0 ]; then f="$(readlink -f -- "$1")"; setsid -f "$bin" "$f" >/dev/null 2>&1 </dev/null
else setsid -f "$bin" >/dev/null 2>&1 </dev/null; fi
nw_info "LibreSprite is starting on workspace 2. Save sprites into: $dir"
