#!/usr/bin/env bash
# new-raylib NAME [--no-git] — create ~/Projects/NAME from the raylib template (never overwrites)
set -euo pipefail
case "${1:-}" in ''|-h|--help) echo "Usage: new-raylib NAME [--no-git]   Create ~/Projects/NAME from the raylib template"; [ -n "${1:-}" ]; exit $? ;; esac
exec nullptr-new raylib "$@"
