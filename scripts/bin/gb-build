#!/usr/bin/env bash
set -euo pipefail
_d="$(dirname -- "$(readlink -f -- "$0")")"
for _l in "$_d/../lib/nullptr" "$_d/../lib"; do [ -f "$_l/nullptr-common.sh" ] && break; done
# shellcheck source=../lib/nullptr-common.sh
. "$_l/nullptr-common.sh"
# shellcheck source=../lib/nullptr-actions.sh
. "$_l/nullptr-actions.sh"
NW_CMD=gb-build   # shown by nw_resolve_project in its "refusing to guess" hint
export NW_CMD
cfg=debug; proj=""
while [ $# -gt 0 ]; do
  case "$1" in
    --release|-r) cfg=release ;; --debug|-d) cfg=debug ;;
    -h|--help) echo "Usage: gb-build [--release] [PROJECT]   Build the Game Boy ROM (Debug includes C source debug info)"; exit 0 ;;
    -*) exit 64 ;; *) proj="$1" ;;
  esac; shift
done
root="$(nw_resolve_project "$proj")"
[ "$(nw_type "$root")" = gameboy ] || nw_die "$(basename "$root") is a $(nw_type "$root") project, not a Game Boy project. Use: build"
nw_banner "Building ROM ($cfg)" "$root"
nw_do_build "$root" "$cfg"
