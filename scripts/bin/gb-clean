#!/usr/bin/env bash
set -euo pipefail
_d="$(dirname -- "$(readlink -f -- "$0")")"
for _l in "$_d/../lib/nullptr" "$_d/../lib"; do [ -f "$_l/nullptr-common.sh" ] && break; done
# shellcheck source=../lib/nullptr-common.sh
. "$_l/nullptr-common.sh"
# shellcheck source=../lib/nullptr-actions.sh
. "$_l/nullptr-actions.sh"
NW_CMD=gb-clean   # shown by nw_resolve_project in its "refusing to guess" hint
export NW_CMD
proj="${1:-}"
case "$proj" in -h|--help) echo "Usage: gb-clean [PROJECT]   Remove build/ (ROMs, .cdb, .map, objects)"; exit 0 ;; esac
root="$(nw_resolve_project "$proj")"
[ "$(nw_type "$root")" = gameboy ] || nw_die "$(basename "$root") is not a Game Boy project."
nw_banner "Cleaning" "$root"
nw_do_clean "$root"
