#!/usr/bin/env bash
set -euo pipefail
_d="$(dirname -- "$(readlink -f -- "$0")")"
for _l in "$_d/../lib/nullptr" "$_d/../lib"; do [ -f "$_l/nullptr-common.sh" ] && break; done
# shellcheck source=../lib/nullptr-common.sh
. "$_l/nullptr-common.sh"
# shellcheck source=../lib/nullptr-actions.sh
. "$_l/nullptr-actions.sh"
NW_CMD=debug-game   # shown by nw_resolve_project in its "refusing to guess" hint
export NW_CMD
usage() { cat <<'U'
Usage: debug-game [--gdb|--emulicious|--vscodium] [PROJECT]
Build a Debug version and start the debugger for the active project.
Default: AstroVim's debugger (nvim-dap) — GDB for raylib, Emulicious for Game Boy.
  --gdb         raylib only: plain GDB text UI instead of AstroVim
  --emulicious  Game Boy only: Emulicious's own built-in debugger window
  --vscodium    Game Boy only: VSCodium + Emulicious Debugger extension (fallback)
U
}
backend=nvim; proj=""
while [ $# -gt 0 ]; do
  case "$1" in
    --gdb) backend=gdb ;; --emulicious) backend=emulicious ;; --vscodium) backend=vscodium ;;
    -h|--help) usage; exit 0 ;; -*) usage >&2; exit 64 ;; *) proj="$1" ;;
  esac; shift
done
root="$(nw_resolve_project "$proj")"
nw_banner "Debugging" "$root"
nw_do_debug "$root" "$backend"
