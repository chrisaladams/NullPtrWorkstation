#!/usr/bin/env bash
# Right side of the tmux status bar: repository + branch of the current pane · battery · network.
# Called by tmux as: nullptr-tmux-status "#{pane_current_path}"
# Prints tmux format strings; must be fast and must never fail.
out=""
if [ -n "${1:-}" ] && top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)"; then
  br="$(git -C "$1" branch --show-current 2>/dev/null)"
  out+="#[fg=#bb9af7] ${top##*/}${br:+ #[fg=#565f89]${br}} "
fi
for b in /sys/class/power_supply/BAT*; do
  [ -r "$b/capacity" ] || continue
  cap="$(cat "$b/capacity")"; st="$(cat "$b/status" 2>/dev/null)"
  icon="󰁹"; [ "$st" = Charging ] && icon="󰂄"
  col="#9ece6a"; [ "$cap" -le 30 ] && col="#e0af68"; [ "$cap" -le 15 ] && col="#f7768e"
  out+="#[fg=$col]$icon $cap% "
  break
done
if command -v nmcli >/dev/null 2>&1; then
  net="$(timeout 1 nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | awk -F: '$1 ~ /wireless|ethernet/ {print $2; exit}')"
  if [ -n "$net" ]; then out+="#[fg=#7aa2f7]󰖩 ${net:0:16} "; else out+="#[fg=#565f89]󰖪 offline "; fi
fi
printf '%s' "$out"
