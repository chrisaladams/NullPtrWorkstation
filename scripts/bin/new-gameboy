#!/usr/bin/env bash
# new-gameboy NAME — create ~/Projects/NAME from the gameboy template (never overwrites)
set -euo pipefail
case "${1:-}" in ''|-h|--help) echo "Usage: new-gameboy NAME   Create ~/Projects/NAME from the gameboy template"; [ -n "${1:-}" ]; exit $? ;; esac
exec nullptr-new gameboy "$@"
