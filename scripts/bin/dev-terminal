#!/usr/bin/env bash
set -euo pipefail
_d="$(dirname -- "$(readlink -f -- "$0")")"
for _l in "$_d/../lib/nullptr" "$_d/../lib"; do [ -f "$_l/nullptr-common.sh" ] && break; done
# shellcheck source=../lib/nullptr-common.sh
. "$_l/nullptr-common.sh"
# shellcheck source=../lib/nullptr-actions.sh
. "$_l/nullptr-actions.sh"
# Focus the main dev terminal (kitty attached to tmux "dev") or start it.
if nw_i3 -t get_tree 2>/dev/null | grep -q '"class":"nullptr-dev"'; then
  nw_i3 -q '[class="^nullptr-dev$"] focus'
else
  nw_i3_workspace 1
  setsid -f kitty --class nullptr-dev --title "nullptr dev" dev >/dev/null 2>&1 </dev/null
fi
