#!/usr/bin/env bash
set -euo pipefail
_d="$(dirname -- "$(readlink -f -- "$0")")"
for _l in "$_d/../lib/nullptr" "$_d/../lib"; do [ -f "$_l/nullptr-common.sh" ] && break; done
# shellcheck source=../lib/nullptr-common.sh
. "$_l/nullptr-common.sh"
# shellcheck source=../lib/nullptr-actions.sh
. "$_l/nullptr-actions.sh"
NW_CMD=run-game   # shown by nw_resolve_project in its "refusing to guess" hint
export NW_CMD
usage() { cat <<'U'
Usage: run-game [--release] [PROJECT]
Build (incrementally) and run the active project:
  raylib  -> runs the game on i3 workspace 6 (game)
  gameboy -> opens the ROM in Emulicious on workspace 6
U
}
cfg=debug; proj=""
while [ $# -gt 0 ]; do
  case "$1" in
    --release|-r) cfg=release ;; --debug|-d) cfg=debug ;;
    -h|--help) usage; exit 0 ;; -*) usage >&2; exit 64 ;; *) proj="$1" ;;
  esac; shift
done
root="$(nw_resolve_project "$proj")"
nw_banner "Running ($cfg)" "$root"
nw_do_run "$root" "$cfg"
