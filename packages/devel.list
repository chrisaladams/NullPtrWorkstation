# C toolchain: clang is the default compiler (cc/c++), gcc stays for build-essential
build-essential
gcc
g++
clang
clangd
clang-format
clang-tidy
# debuggers: LLDB (lldb-dap for AstroVim), GDB (built-in DAP), GDB for other CPUs / remote stubs
lldb
gdb
gdb-multiarch
# build systems; bear writes compile_commands.json for Make projects (clangd reads it)
cmake
ninja-build
make
bear
pkg-config
git
shellcheck
python3
